# HERI VPS connection — EXAMPLE ONLY
# Copy to .env (do NOT commit secrets)

HERI_PORT=8787

# Public base URL that Android will call later, e.g.:
# HERI_API_BASE=https://heri.your-vps.example/api/v1
HERI_API_BASE=

# Auth secrets belong ONLY on VPS — never ship in APK
# HERI_JWT_SECRET=replace-me
# HERI_DEVICE_SIGNING_KEY=replace-me

# Database (later phase)
# HERI_DATABASE_URL=postgres://user:pass@127.0.0.1:5432/heri
