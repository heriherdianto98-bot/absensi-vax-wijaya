# ERP VAX Notification Service — contoh konfigurasi saja.
# JANGAN commit .env asli / password / service role key.

TZ=Asia/Jakarta

# Supabase — service worker membaca Master Tagihan secara read only.
# Simpan secret hanya di VPS, jangan di GitHub/chat.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ON_VPS_ONLY

# Brevo SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=YOUR_BREVO_SMTP_LOGIN
SMTP_PASS=BREVO_SMTP_KEY_ON_VPS_ONLY

MAIL_FROM_NAME=ERP VAX WIJAYA
MAIL_FROM=notification@vaxwijaya.com
MAIL_OWNER=OWNER_EMAIL_HERE
MAIL_SVP=SVP_EMAIL_HERE

# ERP URL tujuan tombol di email
ERP_BASE_URL=https://erp-test.vaxwijaya.com

# Master Tagihan reminder yang dikirim email
TAGIHAN_REMINDER_DAYS=3,2,1,0
